<!--
  Renesas (Hitachi) SH7058: SH-2E core, 1 MB flash, 48 KB RAM, 16 KB on-chip peripherals.
  GENERATED by sh-2e/tools/gen_pspec.py from the SH7058 Hardware Manual (Rev. 3.0)
  register list and exception vector table. Edit the generator, not this file.

  Only vectors 0-15 are labelled at address 0. Resets always read vectors 0-3 from address 0;
  other exceptions use VBR + 4*n, and firmware may move VBR and place code at 0x40.
  Run ghidra_scripts/SH7058_RawImageSetup.java to label the full 0-231 table at the real VBR.
-->
<processor_spec>
  <programcounter register="pc"/>

  <!-- On-chip peripheral space (Table 9.3) is volatile for the decompiler whatever the
       memory block flags say. (The IO block below is also volatile.)
       imask (SR.I3-I0, see superh.sinc) is volatile so that every LDC/RTE write to the
       interrupt mask is printed, including one overwritten before any read (a raise/restore
       bracket) or followed by an infinite loop. On SH-2E nothing reads imask (STC and TRAPA
       read sr), so this adds no read temporaries. -->
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="ram" first="0xFFFFC000" last="0xFFFFFFFF"/>
    <range space="register" first="0x140" last="0x140"/> <!-- imask -->
  </volatile>

