<decompilertest>
<binaryimage arch="SuperH:BE:32:SH-2E:default">
<!--
  SH-2E: an indirect call through a pool constant, with r5 = extu.b r4.  The call resolves to a function
  with a locked prototype taking two 4-byte parameters.  The parameter in r5 must not be trimmed to one
  byte while the target is still unknown: it used to be, and the resolved call then got an invalid 1-to-4
  byte SUBPIECE (here the zero extension was silently lost; in larger functions the decompiler crashed).
     sts.l pr,@-r15; mov.l @(0x1010,pc),r1; extu.b r4,r5; jsr @r1; mov #1,r4
     lds.l @r15+,pr; rts; nop; .long 0x2000
-->
<bytechunk space="ram" offset="0x1000" readonly="true">
4f22d103654c410be4014f26000b0009
00002000
</bytechunk>
<bytechunk space="ram" offset="0x2000" readonly="true">
000b0009
</bytechunk>
<symbol space="ram" offset="0x1000" name="lockedcaller"/>
</binaryimage>
<script>
  <com>option readonly on</com>
  <com>map fun r0x2000 lockedcallee</com>
  <com>parse line extern void lockedcallee(uint4 a,uint4 b);</com>
  <com>lo fu lockedcaller</com>
  <com>dec</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="Locked indirect call parameter #1" min="1" max="1">lockedcallee\(1,param_1 &amp; 0xff\);</stringmatch>
</decompilertest>
