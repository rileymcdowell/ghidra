<binaryimage arch="SuperH:BE:32:SH-2E:default">
<!--
  A value built in a register on several paths and stored to a global once.  The register must not be
  merged with the global when one of its writes is overwritten (or repeated) before the store, or the C
  shows stores to the global that the code never makes.
  presetflag: the delay slot of bt/s presets r2 = 3, the fall-through path overwrites it.
     mov.l @(0x1014,pc),r5; mov.b @(1,r5),r0; mov #4,r6; cmp/hs r6,r0; bt/s 0x1010; mov #3,r2
     mov.l @(0x1018,pc),r6; mov.b @r6,r2; rts; mov.b r2,@r5; .long 0x3000; .long 0x3010
  orflag: r0 = 0 in the delay slot of bf/s, then r0 = 1 at the target of the other branches.
     mov.l @(0x1038,pc),r5; mov.b @(5,r5),r0; cmp/eq #2,r0; bt 0x1030; mov.b @(6,r5),r0; cmp/eq #2,r0
     bf/s 0x1032; mov #0,r0; mov #1,r0; rts; mov.b r0,@(4,r5); nop; .long 0x3020
  selectflag: one write per path, so the merge stays (if/else of two stores).
     mov.l @(0x1054,pc),r5; mov.b @(1,r5),r0; cmp/eq #1,r0; bf 0x104e; mov #7,r2; bra 0x1050; nop
     mov #9,r2; rts; mov.b r2,@r5; .long 0x3040
  loopsum: r2 accumulates in a loop and is stored after it.
     mov.l @(0x1074,pc),r5; mov #0,r2; mov #10,r3; dt r3; bf/s 0x1066; add r4,r2; rts; mov.l r2,@r5
     nop; nop; .long 0x3060
  The next two store the value just before a call, so the store's COPY is folded into the call's
  INDIRECT for the global and the INDIRECT's forced merge must not print the register's writes either.
  callflag: r0 = 0 in the delay slot of bf/s, r0 = 2 on the fall-through, one store, then a call.
     sts.l pr,@-r15; mov.l @(0x201c,pc),r5; mov.b @(1,r5),r0; cmp/eq #1,r0; bf/s 0x200e; mov #0,r0
     mov #2,r0; mov.b r0,@r5; mov.l @(0x2020,pc),r2; jsr @r2; nop; lds.l @r15+,pr; rts; nop
     .long 0x3080; .long 0x2040   (0x2040: rts; nop)
  loopcall: r6 counts in a loop, is stored once after it, then a call.
     sts.l pr,@-r15; mov.l @(0x207c,pc),r5; mov #0,r6; mov #10,r3; dt r3; bf/s 0x2068; add #1,r6
     mov.w r6,@r5; mov.l @(0x2080,pc),r2; jsr @r2; nop; lds.l @r15+,pr; rts; nop
     .long 0x30a0; .long 0x2040
  loadclamp: r6 = 3, or the global's own value, clamped to 6 and stored back once. The MULTIEQUAL
  joins the global with the constant, so merging it with the global would print the constant and
  the clamp as stores.
     mov.l @(0x20bc,pc),r5; mov.b @(1,r5),r0; cmp/eq #1,r0; bf 0x20ac; bra 0x20ae; mov #3,r6
     mov.b @r5,r6; extu.b r6,r2; mov #6,r3; cmp/gt r3,r2; bf 0x20b8; mov #6,r6; rts; mov.b r6,@r5
     .long 0x30c0
-->
